const AppContext = createContext();

// ============================================
// COMPOSANT PRINCIPAL APP
// ============================================

function App() {
  const [currentRole, setCurrentRole] = useState('coop');
  const [blockchainTx, setBlockchainTx] = useState([]);
  const [selectedLotId, setSelectedLotId] = useState('LOT-TG-2026-04791');

  const addTransaction = (tx) => {
    const newTx = { ...tx, id: Date.now(), timestamp: new Date().toLocaleString() };
    setBlockchainTx(prev => [newTx, ...prev]);
    toast.success(`✅ Transaction enregistrée sur Polygon (${tx.hash?.substring(0, 12)}...)`);
  };

  const renderDashboard = () => {
    switch (currentRole) {
      case 'farmer': return <FarmerDashboard onTransaction={addTransaction} />;
      case 'coop': return <CoopDashboard selectedLotId={selectedLotId} setSelectedLotId={setSelectedLotId} onTransaction={addTransaction} />;
      case 'importer': return <ImporterDashboard onTransaction={addTransaction} />;
      case 'admin': return <AdminDashboard blockchainTx={blockchainTx} />;
      default: return <CoopDashboard selectedLotId={selectedLotId} setSelectedLotId={setSelectedLotId} onTransaction={addTransaction} />;
    }
  };

  return (
    <AppContext.Provider value={{ blockchainTx, addTransaction, currentRole, setCurrentRole }}>
      <div className="min-h-screen bg-[#f5f2ea]">
        <div className="container mx-auto px-4 py-6 max-w-7xl">
          <Header currentRole={currentRole} setCurrentRole={setCurrentRole} />
          {renderDashboard()}
          <Toaster position="bottom-right" toastOptions={{ duration: 4000 }} />
          <Footer />
        </div>
      </div>
    </AppContext.Provider>
  );
}

